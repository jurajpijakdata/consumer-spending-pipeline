table _Measures
	lineageTag: 68c92444-41a2-439f-9953-230ee5cd8784

	measure Spending = CALCULATE ( SUM ( 'dbt_dev fact_purchases'[spend_usd] ), 'dbt_dev fact_purchases'[is_gift_card] = 0 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f573f35c-2f2e-4e01-9f2d-dd3cefc47c9f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Purchases = COUNTROWS ( 'dbt_dev fact_purchases' )
		formatString: 0
		lineageTag: 23c217f6-6dab-44af-8436-b399911f484d

	measure Customers = DISTINCTCOUNT ( 'dbt_dev fact_purchases'[customer_id] )
		formatString: #,0.000
		lineageTag: ac4735ff-d3c7-4f05-b594-3408bccb88f8

	measure 'Median Spending per Customer' = MEDIANX ( VALUES ( 'dbt_dev fact_purchases'[customer_id] ), [Spending] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 4a44620e-d171-4c25-bdb1-002c6a065576

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Median Item Price' = MEDIAN ( 'dbt_dev fact_purchases'[unit_price_usd] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9707afc1-1694-4a3e-9f83-61ddbdef0b69

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Spending PY' = CALCULATE ( [Spending], DATEADD ( 'dbt_dev dim_date'[date_day], -1, YEAR ) )
		lineageTag: 392e63e4-1395-4fd5-b3d8-9e73fea3f917

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Spending YoY %' = DIVIDE ( [Spending] - [Spending PY], [Spending PY] )
		lineageTag: 514ce9db-6676-4ad6-8de5-392c710c0ae5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customers Label' = FORMAT ( [Customers], "#,0" )
		lineageTag: 8c843ef4-d4c4-4e6f-89e3-de84ed4e18cb

	measure 'Spending 2019' = CALCULATE ( [Spending], 'dbt_dev dim_date'[year] = 2019 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f450a734-40d8-4f8b-a53b-09ad0c2d418f

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Spending 2020' = CALCULATE ( [Spending], 'dbt_dev dim_date'[year] = 2020 )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1d42d4ff-ef54-43b0-b313-c787d78289f1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'COVID Growth %' = DIVIDE ( [Spending 2020] - [Spending 2019], [Spending 2019] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6e1afe28-c90d-48cb-b728-11f085ac051c

	measure 'Total Spending 2019' = CALCULATE ( [Spending 2019], REMOVEFILTERS ( 'dbt_dev dim_category' ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: d91e1b77-bac8-433a-8daa-dfe39864d5ee

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Spending 2020' = CALCULATE ( [Spending 2020], REMOVEFILTERS ( 'dbt_dev dim_category' ) )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: a33a5131-c4d8-41ab-a9c4-cb2848bb6617

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Growth %' = DIVIDE ( [Total Spending 2020] - [Total Spending 2019], [Total Spending 2019] )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 40548729-d76e-4ebc-b7bd-346a5509e50f

	measure 'Category Share %' = DIVIDE ( [Spending], CALCULATE ( [Spending], REMOVEFILTERS ( 'dbt_dev dim_category' ) ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bffd6c2a-9abf-4d02-9c0e-90b2520827ef

	partition _Measures = m
		mode: import
		source =
				let
				  Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Removed Columns" = Table.RemoveColumns(Source,{"Column1"})
				in
				  #"Removed Columns"

	annotation PBI_ResultType = Table

